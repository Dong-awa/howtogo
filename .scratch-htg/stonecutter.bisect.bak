// The project controller: settings shared by every node.
//
// `stonecutter active` is the node you are editing right now. src/ on disk always holds the
// state of that node, and switching it rewrites src/ in place -- the per-version branches are
// toggled by commenting and uncommenting the `//?` markers, which is why the file you read is
// plain Java and Stonecutter's own view lives in those comments.
plugins {
    id("dev.kikugie.stonecutter")
}

stonecutter active "26.3-neoforge"

stonecutter parameters {
    // `//? if neoforge {` -- available in conditions, so loader-specific code can be written
    // next to version-specific code. The fabric constant arrives with the fabric nodes.
    constants["neoforge"] = true

    // Swaps replace a token in the source with a string computed here. mod_version is read by
    // HowToGo.MOD_VERSION via a literal that this keeps in step with gradle.properties.
    swaps["mod_version"] = "\"${properties.get<String>("mod_version")}\";"

    // Replacements rewrite the shared source per version, so a rename that a release made once
    // does not have to be written by hand at every site. They are textual and global within the
    // node they apply to, so each one is declared only where the new name really exists: the
    // shared source is written against the NEWEST spelling, and an older node gets the older
    // name substituted back in.
    replacements {
        // Xaero's element renderer swapped its live-buffer parameter when the third-tier
        // rendering API arrived. 26.1 hands the renderer a vanilla BufferSource; 26.2 moved the
        // same role into XaeroLib's own provider. The call shape is identical --
        // getBuffer(RenderType) returns a VertexConsumer either way -- so only the type name
        // changes. The import is rewritten first and in full, because the two types live in
        // different packages: a bare name replacement alone would leave a nonsense import.
        string(current.parsed < "26.2") {
            replace("import xaero.lib.client.graphics.XaeroBufferProvider;",
                    "import net.minecraft.client.renderer.MultiBufferSource;")
            replace("XaeroBufferProvider", "MultiBufferSource.BufferSource")
        }

        // 26.1 rebuilt GUI drawing around an extraction pass: what used to be GuiGraphics -- the
        // object a screen or HUD handler draws through -- is now GuiGraphicsExtractor, and the two
        // state hooks on it were renamed with it (render -> extractRenderState, renderBackground ->
        // extractBackground). The object plays the same role and every call site keeps its shape,
        // so the whole wave is three name substitutions. The import line is rewritten first and in
        // full because the class changed package as well as name: a bare name replacement alone
        // would leave an import of a type that no longer exists anywhere.
        string(current.parsed < "26.1") {
            replace("import net.minecraft.client.gui.GuiGraphicsExtractor;",
                    "import net.minecraft.client.gui.GuiGraphics;")
            replace("GuiGraphicsExtractor", "GuiGraphics")
        }
        // BISECT1

        // The same 26.1 wave renamed the text call on that object: the long-standing
        // GuiGraphics.drawString was shortened to GuiGraphicsExtractor.text, overload for overload
        // (String, Component and FormattedCharSequence, each with and without the drop-shadow
        // flag). The source is written in the new spelling and an older node gets the old name
        // back, so the pattern is the new one: `graphics.text(` -> `graphics.drawString(`. The
        // receiver is part of the pattern because the replacement is textual: Xaero's buffer
        // source keeps its own drawString and the map renderers below legitimately call that one,
        // so only the GUI drawing object the panels are handed is rewritten.
        string(current.parsed < "26.1") {
            replace("graphics.text(", "graphics.drawString(")
        }

        // The extraction pass renamed the state hook alongside the context: what a screen
        // overrode as render(GuiGraphics, int, int, float) is now
        // extractRenderState(GuiGraphicsExtractor, int, int, float), and renderBackground became
        // extractBackground. Same arguments, same contract -- the method is simply called by
        // vanilla's new pass rather than by the old one -- so the two are one substitution each.
        // The pattern stops at the opening parenthesis so that one rule covers the declaration
        // (whose parameter is named) and the super/parent call (whose is not), and it anchors on
        // the whole method name so RenderPipeline.render(...) -- which keeps its name -- is left
        // alone.
        string(current.parsed < "26.1") {
            replace("extractRenderState(", "render(")
            replace("extractBackground(", "renderBackground(")
        }

            }
}
