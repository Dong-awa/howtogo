# Build and development output
.gradle/
build/
run/
logs/
.idea/
*.iml
.eclipse/
.vscode/

# Release output. `gradlew collectDist` regenerates it and names the files after mod_version, so the
# directory is build state, not source: the previous version's jars live in its GitHub release and in
# git history, and the current ones are reproduced by one command. Nothing in here is committed any
# more -- dist/README.md included, since it describes whatever the last collect produced.
dist/

# Stonecutter's per-node project tree, with one exception. Each versions/<node>/build holds that
# node's own copy of the sources, its jars and its run directory, all of which are build state. The
# per-node gradle.properties is the opposite: it carries the dependency wiring (deps.neo_loader,
# deps.xaero, dependencySubstitutions...) that the shared build scripts read, so it stays tracked.
# Ignoring everything under versions/ and re-including just that file keeps `git add -A` from picking
# the tree up again while leaving the node configuration in the repository.
/versions/*
!/versions/*/
/versions/*/*
!/versions/*/gradle.properties

# The Xaero World Map jar is a compileOnly dependency and is NOT redistributed: it is closed-source
# commercial software. Put your own copy in libs/ before building -- see libs/README.md.
libs/*.jar

# The routing harness's own output: compiled classes and the classpath gradle printed for it.
tools/routing-harness/build/

# Local reconnaissance scratch.
#
# This directory holds decompiled Minecraft sources, decompiled Xaero classes and copies of their
# jars -- collected locally to read how those programs behave. None of it is this project's code:
# the Minecraft sources are Mojang's and redistributing them is forbidden by the Minecraft EULA, and
# the Xaero classes are that author's closed-source work. Publishing either would be a licence
# breach, so the whole directory stays out of the repository.
.recon/

# Offline build infrastructure: local maven mirror seeded from the Gradle cache,
# the unpacked Gradle distribution and the redirected GRADLE_USER_HOME. Machine-local,
# reproducible from the notes in .recon/NETWORK-NOTES.md — never commit the binaries.
.recon/
.gradle-home/
local-first.gradle

# per-branch worktrees
.worktrees/

# Scratch from API reconnaissance, not part of the tree.
.recon-tmp/

# Working scratch: per-node source snapshots taken while porting, and the tool's own notes.
# Neither is part of the tree, and both were committed to main once by a `git add -A` that did
# not have these lines to stop it.
.scratch-htg/
.workbuddy-ai/
