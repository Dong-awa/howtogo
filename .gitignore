# Build and development output
.gradle/
build/
run/
logs/
.idea/
*.iml
.eclipse/
.vscode/

# The Xaero World Map jar is a compileOnly dependency and is NOT redistributed: it is closed-source
# commercial software. Put your own copy in libs/ before building -- see libs/README.md.
libs/*.jar

# The routing harness's own output: compiled classes and the classpath gradle printed for it.
tools/routing-harness/build/

# Local reconnaissance scratch.
#
# This directory holds decompiled Minecraft sources, decompiled Xaero classes and copies of their
# jars -- collected locally to read how those programs behave. None of it is this project's code:
# the Minecraft sources are Mojang's and redistributing them is forbidden by the Minecraft EULA, and
# the Xaero classes are that author's closed-source work. Publishing either would be a licence
# breach, so the whole directory stays out of the repository.
.recon/

# Offline build infrastructure: local maven mirror seeded from the Gradle cache,
# the unpacked Gradle distribution and the redirected GRADLE_USER_HOME. Machine-local,
# reproducible from the notes in .recon/NETWORK-NOTES.md — never commit the binaries.
.recon/
.gradle-dist/
.gradle-home/
local-first.gradle

# per-branch worktrees
.worktrees/

# Scratch from API reconnaissance, not part of the tree.
.recon-tmp/

# Agent scratch, not part of the tree.
.scratch-htg/
.workbuddy-ai/

# The Forge build is a second Gradle root. Its src/ is a junction to ../src, and its versions/
# and build outputs are generated.
forge-build/src
forge-build/versions
forge-build/.gradle

# The forge build's own GRADLE_USER_HOME. Separate from .gradle-home on purpose: sharing one
# across Gradle versions corrupts its caches.
.gradle-home-forge/
.gradle-dist/
